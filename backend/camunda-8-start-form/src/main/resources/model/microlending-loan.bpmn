      <bpmn:sequenceFlow id="Flow_gw-decision_manual-assessment" name="Refer" sourceRef="gw-decision" targetRef="manual-assessment">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=creditDecision.outcome = &quot;REFER&quot;</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_gw-decision_uc02-end" name="Approve / Decline" sourceRef="gw-decision" targetRef="uc02-end" />
      <bpmn:sequenceFlow id="Flow_fraud-investigation_uc02-end" sourceRef="fraud-investigation" targetRef="uc02-end" />
      <bpmn:sequenceFlow id="Flow_manual-assessment_uc02-end" sourceRef="manual-assessment" targetRef="uc02-end" />
