        </bpmn:extensionElements>
        <bpmn:incoming>Flow_generate-agreement_send-esignature</bpmn:incoming>
        <bpmn:outgoing>Flow_send-esignature_wait-signature</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="manual-signing" name="Arrange manual signing">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="credit-officer" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_esign-down_manual-signing</bpmn:incoming>
        <bpmn:outgoing>Flow_manual-signing_wait-signature</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:receiveTask id="wait-signature" name="Wait for customer signature" messageRef="Message_agreement_signed">
        <bpmn:incoming>Flow_send-esignature_wait-signature</bpmn:incoming>
        <bpmn:incoming>Flow_manual-signing_wait-signature</bpmn:incoming>
        <bpmn:outgoing>Flow_wait-signature_gw-disburse</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:serviceTask id="withdraw-offer" name="Withdraw offer">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="withdraw-offer" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_sign-deadline_withdraw-offer</bpmn:incoming>
        <bpmn:outgoing>Flow_withdraw-offer_uc03-end-expired</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="uc03-end-expired" name="Not signed in time">
        <bpmn:incoming>Flow_withdraw-offer_uc03-end-expired</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="gw-disburse">
        <bpmn:incoming>Flow_wait-signature_gw-disburse</bpmn:incoming>
        <bpmn:incoming>Flow_resolve-transfer_gw-disburse</bpmn:incoming>
        <bpmn:outgoing>Flow_gw-disburse_disburse</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="disburse" name="Pay out loan (bank transfer)">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="disburse-funds" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_gw-disburse_disburse</bpmn:incoming>
        <bpmn:outgoing>Flow_disburse_wait-payment</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="resolve-transfer" name="Resolve failed bank transfer">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="operations" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_transfer-failed_resolve-transfer</bpmn:incoming>
        <bpmn:outgoing>Flow_resolve-transfer_gw-disburse</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:receiveTask id="wait-payment" name="Receive payment confirmation" messageRef="Message_disbursement_confirmed">
        <bpmn:incoming>Flow_disburse_wait-payment</bpmn:incoming>
        <bpmn:outgoing>Flow_wait-payment_activate-loan</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:serviceTask id="activate-loan" name="Activate loan account &amp; notify customer">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="activate-loan-account" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_wait-payment_activate-loan</bpmn:incoming>
        <bpmn:outgoing>Flow_activate-loan_uc03-end</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="uc03-end" name="Loan disbursed">
        <bpmn:incoming>Flow_activate-loan_uc03-end</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:boundaryEvent id="esign-down" name="E-signature unavailable" attachedToRef="send-esignature">
        <bpmn:outgoing>Flow_esign-down_manual-signing</bpmn:outgoing>
        <bpmn:errorEventDefinition errorRef="Error_ESIGN_UNAVAILABLE" />
      </bpmn:boundaryEvent>
      <bpmn:boundaryEvent id="sign-deadline" name="Signing deadline" attachedToRef="wait-signature">
        <bpmn:outgoing>Flow_sign-deadline_withdraw-offer</bpmn:outgoing>
        <bpmn:timerEventDefinition>
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=signDeadline</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:boundaryEvent id="transfer-failed" name="Transfer failed" attachedToRef="disburse">
        <bpmn:outgoing>Flow_transfer-failed_resolve-transfer</bpmn:outgoing>
        <bpmn:errorEventDefinition errorRef="Error_TRANSFER_FAILED" />
      </bpmn:boundaryEvent>
      <bpmn:sequenceFlow id="Flow_uc03-start_approval-level" sourceRef="uc03-start" targetRef="approval-level" />
      <bpmn:sequenceFlow id="Flow_approval-level_officer-approval" sourceRef="approval-level" targetRef="officer-approval" />
      <bpmn:sequenceFlow id="Flow_officer-approval_gw-officer" sourceRef="officer-approval" targetRef="gw-officer" />
      <bpmn:sequenceFlow id="Flow_gw-officer_senior-approval" name="Approve - senior needed" sourceRef="gw-officer" targetRef="senior-approval">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=officerApproval = &quot;APPROVE&quot; and approvalLevel = &quot;SENIOR&quot;</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_gw-officer_generate-agreement" name="Approve" sourceRef="gw-officer" targetRef="generate-agreement">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=officerApproval = &quot;APPROVE&quot; and approvalLevel != &quot;SENIOR&quot;</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_gw-officer_uc03-end-rejected" name="Reject" sourceRef="gw-officer" targetRef="uc03-end-rejected" />
      <bpmn:sequenceFlow id="Flow_senior-approval_gw-senior" sourceRef="senior-approval" targetRef="gw-senior" />
      <bpmn:sequenceFlow id="Flow_gw-senior_generate-agreement" name="Approve" sourceRef="gw-senior" targetRef="generate-agreement">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=seniorApproval = &quot;APPROVE&quot;</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_gw-senior_uc03-end-senior-rejected" name="Reject" sourceRef="gw-senior" targetRef="uc03-end-senior-rejected" />
      <bpmn:sequenceFlow id="Flow_generate-agreement_send-esignature" sourceRef="generate-agreement" targetRef="send-esignature" />
      <bpmn:sequenceFlow id="Flow_send-esignature_wait-signature" sourceRef="send-esignature" targetRef="wait-signature" />
      <bpmn:sequenceFlow id="Flow_esign-down_manual-signing" sourceRef="esign-down" targetRef="manual-signing" />
      <bpmn:sequenceFlow id="Flow_manual-signing_wait-signature" sourceRef="manual-signing" targetRef="wait-signature" />
      <bpmn:sequenceFlow id="Flow_wait-signature_gw-disburse" sourceRef="wait-signature" targetRef="gw-disburse" />
      <bpmn:sequenceFlow id="Flow_sign-deadline_withdraw-offer" sourceRef="sign-deadline" targetRef="withdraw-offer" />
      <bpmn:sequenceFlow id="Flow_withdraw-offer_uc03-end-expired" sourceRef="withdraw-offer" targetRef="uc03-end-expired" />
      <bpmn:sequenceFlow id="Flow_gw-disburse_disburse" sourceRef="gw-disburse" targetRef="disburse" />
      <bpmn:sequenceFlow id="Flow_disburse_wait-payment" sourceRef="disburse" targetRef="wait-payment" />
      <bpmn:sequenceFlow id="Flow_transfer-failed_resolve-transfer" sourceRef="transfer-failed" targetRef="resolve-transfer" />
      <bpmn:sequenceFlow id="Flow_resolve-transfer_gw-disburse" name="Retry" sourceRef="resolve-transfer" targetRef="gw-disburse" />
      <bpmn:sequenceFlow id="Flow_wait-payment_activate-loan" sourceRef="wait-payment" targetRef="activate-loan" />
      <bpmn:sequenceFlow id="Flow_activate-loan_uc03-end" sourceRef="activate-loan" targetRef="uc03-end" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="gw-disbursed" name="Loan disbursed?" default="Flow_gw-disbursed_close-uc03">
      <bpmn:incoming>Flow_uc03_gw-disbursed</bpmn:incoming>
      <bpmn:outgoing>Flow_gw-disbursed_close-uc03</bpmn:outgoing>
      <bpmn:outgoing>Flow_gw-disbursed_uc04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="close-uc03" name="Close application &amp; notify customer">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="close-application" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_gw-disbursed_close-uc03</bpmn:incoming>
      <bpmn:outgoing>Flow_close-uc03_end-closed</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end-closed" name="Application closed">
      <bpmn:incoming>Flow_close-uc03_end-closed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="uc04" name="UC04 - Repayments &amp; collections">
      <bpmn:incoming>Flow_gw-disbursed_uc04</bpmn:incoming>
      <bpmn:outgoing>Flow_uc04_end-loan-closed</bpmn:outgoing>
      <bpmn:startEvent id="uc04-start">
        <bpmn:outgoing>Flow_uc04-start_next-repayment</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="next-repayment" name="Get next repayment from schedule">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="get-next-repayment" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_uc04-start_next-repayment</bpmn:incoming>
        <bpmn:incoming>Flow_update-balance_next-repayment</bpmn:incoming>
        <bpmn:outgoing>Flow_next-repayment_gw-due</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="gw-due" name="Repayment due?" default="Flow_gw-due_close-loan">
        <bpmn:incoming>Flow_next-repayment_gw-due</bpmn:incoming>
        <bpmn:outgoing>Flow_gw-due_send-reminder</bpmn:outgoing>
        <bpmn:outgoing>Flow_gw-due_close-loan</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="close-loan" name="Close loan account">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="close-loan-account" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_gw-due_close-loan</bpmn:incoming>
        <bpmn:outgoing>Flow_close-loan_uc04-end-repaid</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="uc04-end-repaid" name="Loan fully repaid">
        <bpmn:incoming>Flow_close-loan_uc04-end-repaid</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:serviceTask id="send-reminder" name="Send repayment reminder">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="send-repayment-reminder" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_gw-due_send-reminder</bpmn:incoming>
        <bpmn:outgoing>Flow_send-reminder_due-date</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:intermediateCatchEvent id="due-date" name="Due date">
        <bpmn:incoming>Flow_send-reminder_due-date</bpmn:incoming>
        <bpmn:outgoing>Flow_due-date_gw-collect</bpmn:outgoing>
        <bpmn:timerEventDefinition>
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=dueDateWait</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="gw-collect">
        <bpmn:incoming>Flow_due-date_gw-collect</bpmn:incoming>
        <bpmn:incoming>Flow_update-bank-details_gw-collect</bpmn:incoming>
        <bpmn:incoming>Flow_retry-wait_gw-collect</bpmn:incoming>
        <bpmn:outgoing>Flow_gw-collect_direct-debit</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="direct-debit" name="Collect by direct debit">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="initiate-direct-debit" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_gw-collect_direct-debit</bpmn:incoming>
        <bpmn:outgoing>Flow_direct-debit_wait-result</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:receiveTask id="wait-result" name="Receive payment result" messageRef="Message_payment_result">
        <bpmn:incoming>Flow_direct-debit_wait-result</bpmn:incoming>
        <bpmn:outgoing>Flow_wait-result_gw-paid</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:exclusiveGateway id="gw-paid" name="Paid?" default="Flow_gw-paid_notify-failed">
        <bpmn:incoming>Flow_wait-result_gw-paid</bpmn:incoming>
        <bpmn:outgoing>Flow_gw-paid_update-balance</bpmn:outgoing>
        <bpmn:outgoing>Flow_gw-paid_notify-failed</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="update-balance" name="Update loan balance">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="update-outstanding-balance" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_gw-paid_update-balance</bpmn:incoming>
        <bpmn:incoming>Flow_gw-recovered_update-balance</bpmn:incoming>
        <bpmn:outgoing>Flow_update-balance_next-repayment</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="notify-failed" name="Notify customer: payment failed">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="notify-payment-failed" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_gw-paid_notify-failed</bpmn:incoming>
        <bpmn:outgoing>Flow_notify-failed_gw-failure</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="gw-failure" name="Why did it fail?" default="Flow_gw-failure_collections">
        <bpmn:incoming>Flow_notify-failed_gw-failure</bpmn:incoming>
        <bpmn:outgoing>Flow_gw-failure_update-bank-details</bpmn:outgoing>
        <bpmn:outgoing>Flow_gw-failure_retry-wait</bpmn:outgoing>
        <bpmn:outgoing>Flow_gw-failure_collections</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="update-bank-details" name="Customer updates bank details">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition assignee="=customerUsername" candidateGroups="customer" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_gw-failure_update-bank-details</bpmn:incoming>
        <bpmn:outgoing>Flow_update-bank-details_gw-collect</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:intermediateCatchEvent id="retry-wait" name="Wait, then retry">
        <bpmn:incoming>Flow_gw-failure_retry-wait</bpmn:incoming>
        <bpmn:outgoing>Flow_retry-wait_gw-collect</bpmn:outgoing>
        <bpmn:timerEventDefinition>
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=paymentRetryDelay</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:userTask id="collections" name="Collections follow-up">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="collections" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_gw-failure_collections</bpmn:incoming>
        <bpmn:outgoing>Flow_collections_gw-recovered</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="gw-recovered" name="Recovered?" default="Flow_gw-recovered_uc04-end-defaulted">
        <bpmn:incoming>Flow_collections_gw-recovered</bpmn:incoming>
        <bpmn:outgoing>Flow_gw-recovered_update-balance</bpmn:outgoing>
        <bpmn:outgoing>Flow_gw-recovered_uc04-end-defaulted</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="uc04-end-defaulted" name="Loan defaulted">
        <bpmn:incoming>Flow_gw-recovered_uc04-end-defaulted</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:subProcess id="dispute" name="Customer disputes a repayment" triggeredByEvent="true">
        <bpmn:startEvent id="dispute-start" name="Dispute raised" isInterrupting="false">
          <bpmn:outgoing>Flow_dispute-start_investigate-dispute</bpmn:outgoing>
          <bpmn:messageEventDefinition messageRef="Message_repayment_disputed" />
        </bpmn:startEvent>
        <bpmn:userTask id="investigate-dispute" name="Investigate dispute">
          <bpmn:extensionElements>
            <zeebe:assignmentDefinition candidateGroups="collections" />
          </bpmn:extensionElements>
          <bpmn:incoming>Flow_dispute-start_investigate-dispute</bpmn:incoming>
          <bpmn:outgoing>Flow_investigate-dispute_record-dispute</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:serviceTask id="record-dispute" name="Record outcome &amp; notify customer">
          <bpmn:extensionElements>
            <zeebe:taskDefinition type="record-dispute-outcome" retries="3" />
          </bpmn:extensionElements>
          <bpmn:incoming>Flow_investigate-dispute_record-dispute</bpmn:incoming>
          <bpmn:outgoing>Flow_record-dispute_dispute-end</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:endEvent id="dispute-end" name="Dispute closed">
          <bpmn:incoming>Flow_record-dispute_dispute-end</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_dispute-start_investigate-dispute" sourceRef="dispute-start" targetRef="investigate-dispute" />
        <bpmn:sequenceFlow id="Flow_investigate-dispute_record-dispute" sourceRef="investigate-dispute" targetRef="record-dispute" />
        <bpmn:sequenceFlow id="Flow_record-dispute_dispute-end" sourceRef="record-dispute" targetRef="dispute-end" />
      </bpmn:subProcess>
      <bpmn:subProcess id="date-change" name="Customer asks for a new repayment date" triggeredByEvent="true">
        <bpmn:startEvent id="date-change-start" name="New date requested" isInterrupting="false">
          <bpmn:outgoing>Flow_date-change-start_review-date-change</bpmn:outgoing>
          <bpmn:messageEventDefinition messageRef="Message_repayment_date_change" />
        </bpmn:startEvent>
        <bpmn:userTask id="review-date-change" name="Review date change">
          <bpmn:extensionElements>
            <zeebe:assignmentDefinition candidateGroups="credit-officer" />
          </bpmn:extensionElements>
          <bpmn:incoming>Flow_date-change-start_review-date-change</bpmn:incoming>
          <bpmn:outgoing>Flow_review-date-change_update-schedule</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:serviceTask id="update-schedule" name="Update schedule &amp; notify customer">
          <bpmn:extensionElements>
            <zeebe:taskDefinition type="update-repayment-schedule" retries="3" />
          </bpmn:extensionElements>
          <bpmn:incoming>Flow_review-date-change_update-schedule</bpmn:incoming>
          <bpmn:outgoing>Flow_update-schedule_date-change-end</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:endEvent id="date-change-end" name="Request handled">
          <bpmn:incoming>Flow_update-schedule_date-change-end</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_date-change-start_review-date-change" sourceRef="date-change-start" targetRef="review-date-change" />
        <bpmn:sequenceFlow id="Flow_review-date-change_update-schedule" sourceRef="review-date-change" targetRef="update-schedule" />
        <bpmn:sequenceFlow id="Flow_update-schedule_date-change-end" sourceRef="update-schedule" targetRef="date-change-end" />
      </bpmn:subProcess>
      <bpmn:sequenceFlow id="Flow_uc04-start_next-repayment" sourceRef="uc04-start" targetRef="next-repayment" />
      <bpmn:sequenceFlow id="Flow_next-repayment_gw-due" sourceRef="next-repayment" targetRef="gw-due" />
      <bpmn:sequenceFlow id="Flow_gw-due_send-reminder" name="Yes" sourceRef="gw-due" targetRef="send-reminder">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=hasNextRepayment = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_gw-due_close-loan" name="No" sourceRef="gw-due" targetRef="close-loan" />
      <bpmn:sequenceFlow id="Flow_close-loan_uc04-end-repaid" sourceRef="close-loan" targetRef="uc04-end-repaid" />
      <bpmn:sequenceFlow id="Flow_send-reminder_due-date" sourceRef="send-reminder" targetRef="due-date" />
      <bpmn:sequenceFlow id="Flow_due-date_gw-collect" sourceRef="due-date" targetRef="gw-collect" />
      <bpmn:sequenceFlow id="Flow_gw-collect_direct-debit" sourceRef="gw-collect" targetRef="direct-debit" />
      <bpmn:sequenceFlow id="Flow_direct-debit_wait-result" sourceRef="direct-debit" targetRef="wait-result" />
      <bpmn:sequenceFlow id="Flow_wait-result_gw-paid" sourceRef="wait-result" targetRef="gw-paid" />
      <bpmn:sequenceFlow id="Flow_gw-paid_update-balance" name="Yes" sourceRef="gw-paid" targetRef="update-balance">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=paymentStatus = &quot;SUCCESS&quot;</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_gw-paid_notify-failed" name="No" sourceRef="gw-paid" targetRef="notify-failed" />
      <bpmn:sequenceFlow id="Flow_update-balance_next-repayment" name="Next instalment" sourceRef="update-balance" targetRef="next-repayment" />
      <bpmn:sequenceFlow id="Flow_notify-failed_gw-failure" sourceRef="notify-failed" targetRef="gw-failure" />
      <bpmn:sequenceFlow id="Flow_gw-failure_update-bank-details" name="Wrong bank details" sourceRef="gw-failure" targetRef="update-bank-details">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=failureReason = &quot;INCORRECT_ACCOUNT&quot;</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_gw-failure_retry-wait" name="No funds - retry" sourceRef="gw-failure" targetRef="retry-wait">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=failureReason != &quot;INCORRECT_ACCOUNT&quot; and attempts &lt; maxPaymentAttempts</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_gw-failure_collections" name="Failed again" sourceRef="gw-failure" targetRef="collections" />
      <bpmn:sequenceFlow id="Flow_update-bank-details_gw-collect" sourceRef="update-bank-details" targetRef="gw-collect" />
      <bpmn:sequenceFlow id="Flow_retry-wait_gw-collect" sourceRef="retry-wait" targetRef="gw-collect" />
      <bpmn:sequenceFlow id="Flow_collections_gw-recovered" sourceRef="collections" targetRef="gw-recovered" />
      <bpmn:sequenceFlow id="Flow_gw-recovered_update-balance" name="Yes" sourceRef="gw-recovered" targetRef="update-balance">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=collectionsOutcome = &quot;PAID&quot;</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
